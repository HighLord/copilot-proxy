# Server port
PORT=3000

# Where data (users, conversations, auth sessions, admin settings) is stored.
# DATA_DIR=./data

# Optional secret for the Admin tab. When unset, any signed-in user can edit admin settings.
# ADMIN_API_KEY=

# Set 1 to use the local mock Copilot + mock sign-in (no browser, no Microsoft account).
# COPILOT_MOCK=0

# Sign-in
# COPILOT_LOGIN_URL=https://copilot.cloud.microsoft
# COPILOT_HEADLESS=1                 # 0 shows the browser during sign-in (for troubleshooting)
# COPILOT_CHATHUB_WS_HOST=substrate.office.com

# Debug: write every SignalR frame to DATA_DIR/debug/*.jsonl (access_token is redacted).
# COPILOT_DEBUG_FRAMES=0
